                      <Properties>
                        <Property name="columns" type="int" value="20"/>
                        <Property name="rows" type="int" value="5"/>
                        <Property name="text" type="java.lang.String" value="A independ&#xea;ncia pode &#xe0;s vezes se transformar em dificuldade para aceitar conselhos ou opini&#xf5;es diferentes. Aqu&#xe1;rio pode ficar t&#xe3;o concentrado em suas ideias que acaba parecendo distante emocionalmente."/>
                      </Properties>
                    </Component>
                  </SubComponents>
                </Container>
              </SubComponents>
