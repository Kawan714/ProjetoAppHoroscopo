                  <SubComponents>
                    <Component class="javax.swing.JTextArea" name="txFortesPeixes">
                      <Properties>
                        <Property name="columns" type="int" value="20"/>
                        <Property name="rows" type="int" value="5"/>
                        <Property name="text" type="java.lang.String" value="Peixes costuma ser associado &#xe0; empatia, sensibilidade e imagina&#xe7;&#xe3;o. &#xc9; um signo que pode perceber facilmente o clima emocional de um ambiente e se preocupar bastante com as pessoas pr&#xf3;ximas. A criatividade tamb&#xe9;m pode ser uma caracter&#xed;stica muito forte, especialmente em &#xe1;reas art&#xed;sticas."/>
                      </Properties>
                    </Component>
                  </SubComponents>
                </Container>
                <Container class="javax.swing.JScrollPane" name="jScrollPane25">
                  <AuxValues>
                    <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
                  </AuxValues>

                  <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
                  <SubComponents>
                    <Component class="javax.swing.JTextArea" name="txMelhorarPeixes">
                      <Properties>
                        <Property name="columns" type="int" value="20"/>
                        <Property name="rows" type="int" value="5"/>
                        <Property name="text" type="java.lang.String" value="Por ser muito sens&#xed;vel, Peixes pode absorver facilmente os problemas e emo&#xe7;&#xf5;es de outras pessoas. Isso pode acabar deixando a pessoa emocionalmente cansada. Tamb&#xe9;m pode idealizar pessoas ou situa&#xe7;&#xf5;es e criar expectativas que n&#xe3;o correspondem &#xe0; realidade."/>
                      </Properties>
                    </Component>
                  </SubComponents>
                </Container>
              </SubComponents>
